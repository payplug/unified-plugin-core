# Copy to .env and fill in the real values to run `make test-integration` locally.
# .env is gitignored — never commit real credentials or fill these in here.
# Requires VPN access to the identity provider and the Unified API staging environment.

# Identity provider (client-credentials flow), see Auth/OAuth2Client
UPC_IT_OAUTH_BASE_URL=
UPC_IT_OAUTH_SCOPE=
UPC_IT_OAUTH_AUDIENCE=
UPC_IT_CLIENT_ID=
UPC_IT_CLIENT_SECRET=

# Unified API (Services/UnifiedApiPaymentService)
UPC_IT_UNIFIED_API_BASE_URL=
UPC_IT_PAYMENT_ID=
# Required by createRefund() for a submerchant-routed account — confirmed against the real staging
# API (2026-08-27) to be required alongside orderId/description, not merely account-optional.
UPC_IT_SUBMERCHANT_ID=

# Unified API hosted-fields payment creation (Services/UnifiedApiHostedPaymentService)
UPC_IT_ACCOUNT_ID=
# UPC_IT_HF_TOKEN is single-use and short-lived: mint a fresh one via the hosted-fields JS SDK in a
# browser immediately before each local run — unlike UPC_IT_PAYMENT_ID, it cannot be a static value.
UPC_IT_HF_TOKEN=
